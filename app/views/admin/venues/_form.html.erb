<%= simple_form_for(@venue, url: url, html: { method: method }) do |f| %> 
	<%= f.error_notification %>

	<%= f.input :name, label: "Venue" %>
	<%= f.input :database_code, label: "Venue code" %>
	<%= f.input :active %>
	<%= f.input :address, :label => "Street address" %>
	<%= f.input :hub %>
	<%= f.input :court_notes, :label => "Court notes", as: :text, input_html: { rows: 4 } %>

	<%= f.button :submit %>
<% end %>	
